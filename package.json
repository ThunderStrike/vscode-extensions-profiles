{
  "name": "vscode-profiles-plus",
  "displayName": "Profiles Plus",
  "description": "Advanced operations for VSCode profiles - merge, compare, analyze",
  "version": "2.0.0",
  "private": false,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "profile",
    "profiles",
    "extensions",
    "workspace",
    "manager",
    "merge",
    "compare"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ThunderStrike/vscode-extensions-profiles.git"
  },
  "icon": "assets/icon.png",
  "license": "Apache-2.0",
  "author": {
    "name": "ThunderStrike",
    "url": "https://github.com/ThunderStrike"
  },
  "publisher": "ThunderStrike",
  "main": "./out/src/extension.js",
  "scripts": {
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "vscode:prepublish": "npm run prepackage && npm run compile",
    "compile": "rm -rf ./out && tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test"
  },
  "contributes": {
    "commands": [
      {
        "command": "profiles-plus.create",
        "title": "Create Profile",
        "category": "Profiles Plus"
      },
      {
        "command": "profiles-plus.switch",
        "title": "Switch Profile",
        "category": "Profiles Plus"
      },
      {
        "command": "profiles-plus.export",
        "title": "Export Profile",
        "category": "Profiles Plus"
      },
      {
        "command": "profiles-plus.import",
        "title": "Import Profile",
        "category": "Profiles Plus"
      },
      {
        "command": "profiles-plus.merge",
        "title": "Merge Profiles",
        "category": "Profiles Plus",
        "icon": "$(git-merge)"
      },
      {
        "command": "profiles-plus.compare",
        "title": "Compare Profiles",
        "category": "Profiles Plus",
        "icon": "$(diff)"
      },
      {
        "command": "profiles-plus.analyze",
        "title": "Analyze Current Profile",
        "category": "Profiles Plus",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "profiles-plus.merge",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "profiles-plus.compare",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "profiles-plus.analyze"
        }
      ]
    }
  },
  "activationEvents": [
    "*"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.4",
    "@types/vscode": "1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vscode/test-cli": "^0.0.11",
    "auto-changelog": "^2.5.0",
    "eslint": "^9.31.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "preview": false
}